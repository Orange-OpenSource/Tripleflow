# TripleFlow API configuration.
# Copy to .env and fill in your deployment values. Unset optional variables
# simply disable the corresponding feature.

# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017/

# CORS
# Comma-separated list of front-end origins allowed to call this API.
# (default: http://localhost:5173, for local development)
CORS_ORIGINS=

# Document parsing
# Use Docling to parse uploaded documents (PDF, DOCX, PPTX, XLSX, HTML, images).
# Set to false to disable and fall back to the lightweight pypdf/txt extractors.
# (default: true)
USE_DOCLING=true