# TripleFlow front-end configuration.
# Copy to .env.local (dev) or .env.production.local (build) and fill in your values.
# All variables are optional; defaults target a local backend.

# Backend API base URL (default: http://127.0.0.1:8000)
VITE_TRIPLEFLOW_API_URL=

# RDF namespaces the wd:/wdt: prefixes of a TTL export expand to. Defaults are
# Wikidata's own, matching what the backend publishes to a SPARQL target, so an
# exported file and a populated graph name the same entities.
# Point these at your instance's RDF bases when grounding on a private Wikibase
# — its entity IRIs, not its /wiki/ page URLs.
# (defaults: http://www.wikidata.org/entity/ and http://www.wikidata.org/prop/direct/)
VITE_TTL_ITEM_BASE_URI=
VITE_TTL_PROPERTY_BASE_URI=

# Footer links as a JSON array of { label, href } objects, e.g.
# VITE_FOOTER_LINKS='[{"label":"Terms of service","href":"https://example.org/terms"}]'
# (default: no links)
VITE_FOOTER_LINKS=
